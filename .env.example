# Copy to .env in the repository root; replace every secret before use.
NODE_ENV=development
APP_PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/FreshVend
JWT_SECRET=replace-with-a-random-jwt-secret
JWT_EXPIRES_IN=8h

# Used by authenticated payment callbacks, IoT HTTP fallback, and MQTT HMAC.
PAYMENT_WEBHOOK_SECRET=FreshVend_Payment_2026_Secret_ABC123
# Guest payment mock is available outside production unless set to false.
PAYMENT_DEMO_ENABLED=true
ORDER_MAINTENANCE_SECRET=replace-with-an-order-maintenance-secret
IOT_DEVICE_SECRET=replace-with-the-same-random-secret-of-at-least-32-bytes-on-all-devices

# Local development broker (Mosquitto is bound to 127.0.0.1 only).
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=freshvend
MQTT_CLIENT_ID=freshvend-backend
MQTT_DISPENSE_MAX_ATTEMPTS=10
MQTT_DISPENSE_RESULT_TIMEOUT_SECONDS=30
